{
  "name": "ideasquared-website",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check:html": "git ls-files -z \"*.html\" | xargs -0 html-validate",
    "check:deploy": "wrangler deploy --dry-run --env= && wrangler deploy --dry-run --env staging"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "wrangler": "^4.166.0"
  }
}
