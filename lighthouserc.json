{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec wrangler dev --env staging --port 8787 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/ventures/",
        "http://127.0.0.1:8787/ventures/adopt-dont-shop/",
        "http://127.0.0.1:8787/ventures/creatrgrid/",
        "http://127.0.0.1:8787/ventures/gaminginit/",
        "http://127.0.0.1:8787/ventures/pairflix/",
        "http://127.0.0.1:8787/how-we-work/",
        "http://127.0.0.1:8787/about/",
        "http://127.0.0.1:8787/press/",
        "http://127.0.0.1:8787/privacy/",
        "http://127.0.0.1:8787/journal/",
        "http://127.0.0.1:8787/tools/",
        "http://127.0.0.1:8787/blog/",
        "http://127.0.0.1:8787/blog/building-shipper/",
        "http://127.0.0.1:8787/blog/stopping-gaminginit/",
        "http://127.0.0.1:8787/blog/every-leak-becomes-a-test/"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 500000 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 5 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
